{
  "manifest_version": 3,
  "name": "Focus Goat — Focus & Study Blocker",
  "version": "1.0.0",
  "description": "Bloquea sitios web que te distraen, mantén rutinas de estudio y motívate con mensajes de alto impacto para ser el GOAT.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Focus Goat"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_scripts/yt_shorts.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "icons/*",
        "media/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
